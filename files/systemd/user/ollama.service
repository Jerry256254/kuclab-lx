[Unit]
Description=Ollama local LLM server (KucLab LX)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.local/share/kuclab/models/ollama
Environment=OLLAMA_KEEP_ALIVE=10m
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
